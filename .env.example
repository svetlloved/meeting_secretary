TELEGRAM_BOT_TOKEN=tg_bot_token
OPENROUTER_API_KEY=or_token

# Бесплатные модели OpenRouter (через запятую — запасные при rate limit)
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-nano-9b-v2:free

# Whisper small на CPU (локальная папка, скачать: python scripts/download_whisper_model.py)
WHISPER_MODEL=small
WHISPER_MODEL_DIR=./models/whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

DATA_DIR=./data
MAX_AUDIO_MB=50
