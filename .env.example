TELEGRAM_BOT_TOKEN=tg_bot_token
OPENROUTER_API_KEY=or_token

# Модель на OpenRouter (примеры: google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Whisper small на CPU
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

DATA_DIR=./data
MAX_AUDIO_MB=50
