TELEGRAM_BOT_TOKEN=tg_bot_token
OPENROUTER_API_KEY=or_token

# Платная модель OpenRouter (~$0.40/1M input, Qwen 72B)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat

# Whisper medium на CPU (локальная папка, скачать: python scripts/download_whisper_model.py)
WHISPER_MODEL=medium
WHISPER_MODEL_DIR=./models/whisper-medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

DATA_DIR=./data
MAX_AUDIO_MB=50

# FastAPI (Docker / Selectel)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
